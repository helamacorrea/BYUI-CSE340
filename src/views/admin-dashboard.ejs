<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>User Accounts</h2>

    <table class="usersList">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% usersList.forEach(user => { %>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role_name %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>

</main>

<%- include('partials/footer') %>