<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>
    <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project Details</a></p>
    <p>Description: <%= projectDetails.description %></p>
    <p>Date: <%= new Date(projectDetails.date).toLocaleDateString('pt-BR') %></p>
    <p>Location: <%= projectDetails.location %></p>
    <p>Partner Organization: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>
    <h2>Categories</h2>
    <a href="/assign-categories/<%= projectId %>">Edit Categories</a>
    <ul>
        <% projectCategories.forEach(category => { %>
        <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }); %>    
    </ul>

</main>
<%- include('partials/footer') %>