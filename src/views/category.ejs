<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <h2><%= categoryName.name %></h2>
        <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-category/<%= categoryId %>">Edit Category Name</a>
        <br><br>
        <% } %>

        <h3>Projects in this category:</h3>
        <ul>
            <% projectsOfCategory.forEach(project => { %>
                <li><a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a></li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>