<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <p><a href="/new-project" >Create a New Service Project</a></p>
        <p>Here are our upcoming service projects:</p>
        <ul>
            <% projects.forEach(project => { %>
                <li><%= new Date(project.date).toLocaleDateString('pt-BR') %>: <a href="/project/<%= project.project_id %>" ><strong><%= project.title %></strong></a> <a href="/organization/<%= project.organization_id %>" >(<%= project.organization_name %>)</a></li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>