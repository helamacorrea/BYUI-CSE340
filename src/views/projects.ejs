<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        
        <p>Here are our upcoming service projects:</p>
        <ul>
            <% projects.forEach(project => { %>
                <li><%= new Date(project.date).toLocaleDateString('pt-BR') %>: <strong><%= project.title %></strong> (<%= project.org_name %>)</li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>